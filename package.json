{
  "name": "agent-skills-eval",
  "version": "1.0.0",
  "description": "Universal agent skills evaluation tool for Claude Code, OpenCode, and other platforms",
  "main": "lib/index.js",
  "bin": {
    "agent-skills-eval": "./bin/cli.js"
  },
  "scripts": {
    "discover": "node bin/cli.js discover",
    "eval": "node bin/cli.js eval",
    "report": "node bin/cli.js report",
    "pipeline": "node bin/cli.js pipeline",
    "pipeline:mock": "node bin/cli.js pipeline -b mock",
    "pipeline:llm": "node bin/cli.js pipeline --llm -b openai-compatible",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "bin/",
    "lib/",
    "evals/",
    "config/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "skills",
    "evaluation",
    "claude-code",
    "opencode",
    "codex",
    "openclaw",
    "benchmark",
    "eval-skills",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/caohaotiantian/agent-skills-eval.git"
  },
  "homepage": "https://github.com/caohaotiantian/agent-skills-eval#readme",
  "bugs": {
    "url": "https://github.com/caohaotiantian/agent-skills-eval/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.1.0",
    "glob": "^10.3.0",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.0",
    "node-fetch": "^3.3.0",
    "openai": "^4.104.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
