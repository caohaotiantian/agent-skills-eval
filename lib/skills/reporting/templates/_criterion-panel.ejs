<%/* Renders one criterion as a collapsible panel.
     Caller passes: { c: criterionResult }
     The criterion object may have new fields (details, locations, suggestion,
     llmSuggestion) populated by lib/skills/evaluating/suggestions.js.
*/%>
<% const statusColor = c.passed ? '#22c55e' : '#ef4444';
   const statusIcon  = c.passed ? '✓' : '✗';
   const partial     = !c.passed || (typeof c.score === 'number' && c.score < c.weight);
   const fix         = c.llmSuggestion || c.suggestion;
%>
<div class="criterion-panel" data-passed="<%= c.passed %>">
  <div class="criterion-header" onclick="this.parentElement.classList.toggle('open')">
    <span><span style="color:<%= statusColor %>;"><%= statusIcon %></span>
      <strong><%= c.name %></strong>
      <span style="color:#6b7280;">(<%= c.score %>/<%= c.weight %>)</span>
    </span>
    <span class="chevron">&#9660;</span>
  </div>
  <div class="criterion-body">
    <% if (c.reasoning) { %>
    <div class="criterion-section">
      <div class="criterion-section-title" data-i18n="criterion.reasoning">Why</div>
      <div class="criterion-reasoning"><%= c.reasoning %></div>
    </div>
    <% } %>
    <% if (partial && c.details && c.details.length > 0) { %>
    <div class="criterion-section">
      <div class="criterion-section-title" data-i18n="criterion.specifics">Specifics</div>
      <ul class="criterion-details">
        <% for (const d of c.details) { %><li><%= d %></li><% } %>
      </ul>
    </div>
    <% } %>
    <% if (partial && c.locations && c.locations.length > 0) { %>
    <div class="criterion-section">
      <div class="criterion-section-title" data-i18n="criterion.location">Location</div>
      <% for (const loc of c.locations) { %>
        <code class="criterion-location"><%= loc.file %><% if (loc.line) { %>:<%= loc.line %><% } %><% if (loc.label) { %> — <%= loc.label %><% } %></code>
      <% } %>
    </div>
    <% } %>
    <% if (partial && fix) { %>
    <div class="criterion-section">
      <div class="criterion-section-title" data-i18n="criterion.suggestion">How to fix
        <% if (c.llmSuggestion) { %><span class="llm-badge" data-i18n="badge.ai_rewritten">AI-rewritten</span><% } %>
      </div>
      <div class="criterion-suggestion"><%- String(fix).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g, '<br>') %></div>
    </div>
    <% } %>
  </div>
</div>
