<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  // Helper: pick score color
  function scoreColor(val) {
    return val >= 70 ? '#22c55e' : val >= 50 ? '#eab308' : '#ef4444';
  }
  // Helper: HTML-escape a string
  function esc(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Determine report type
  const isConsolidated = !!(data.comparison);
  const isSimple = !isPipeline && !isConsolidated;

  // Common data references
  const staticEval = data.static_eval || {};
  const dynamicEval = data.dynamic_eval || {};
  const comparison = data.comparison || {};
  const summary = data.summary || {};
  const rankings = comparison.rankings || [];
%>
<% if (isConsolidated) { %>
<title>Agent Skills Evaluation - Consolidated Report</title>
<% } else if (isPipeline) { %>
<title>Pipeline Evaluation Report</title>
<% } else { %>
<title>Agent Skills Evaluation Report</title>
<% } %>
<style>
<%- css %>
</style>
</head>
<body>
<div class="container">

<% if (isConsolidated) { %>
<%/* ===== CONSOLIDATED REPORT ===== */ %>

<h1>Agent Skills Evaluation Report</h1>
<p class="subtitle">Run: <%= data.run_id %> | Generated: <%= data.created_at %> | Backend: <%= (data.meta && data.meta.backend) || 'N/A' %> | Platform: <%= (data.meta && data.meta.platform) || 'all' %></p>

<%
  const cards = [
    { label: 'Skills Evaluated', value: summary.total_skills_evaluated || 0, cls: 'blue' },
    { label: 'Static Score', value: (summary.static_score != null ? summary.static_score + '%' : 'N/A'), cls: 'purple' },
    { label: 'Dynamic Pass Rate', value: (summary.dynamic_pass_rate != null ? summary.dynamic_pass_rate + '%' : 'N/A'), cls: 'green' },
    { label: 'Composite Score', value: (summary.average_composite_score != null ? summary.average_composite_score + '%' : 'N/A'), cls: 'blue' },
    { label: 'Dynamic Tests', value: summary.total_dynamic_tests || 0, cls: 'blue' },
    { label: 'Avg Efficiency', value: (comparison.averageEfficiency != null ? comparison.averageEfficiency + '%' : 'N/A'), cls: 'purple' },
    { label: 'Thrashing', value: comparison.totalThrashingIncidents || 0, cls: (comparison.totalThrashingIncidents || 0) > 0 ? 'red' : 'green' },
    { label: 'Total Tokens', value: comparison.totalTokensUsed ? comparison.totalTokensUsed.toLocaleString() : 'N/A', cls: 'blue' }
  ];
%>
<div class="summary">
<% for (const c of cards) { %>
  <div class="card <%= c.cls %>"><h3><%= c.label %></h3><p><%= c.value %></p></div>
<% } %>
</div>

<% if (comparison.bestPerformer) { %>
<div style="display:flex;gap:20px;margin:20px 0;">
  <div class="highlight-card highlight-best">
    <div style="font-size:12px;color:#16a34a;font-weight:600;text-transform:uppercase;">Best Performer</div>
    <div style="font-size:20px;font-weight:bold;color:#15803d;"><%= comparison.bestPerformer %></div>
    <% if (rankings[0]) { %><div style="font-size:13px;color:#4ade80;">Composite: <%= rankings[0].compositeScore %></div><% } %>
  </div>
  <% if (comparison.worstPerformer && rankings.length > 1) { %>
  <div class="highlight-card highlight-worst">
    <div style="font-size:12px;color:#dc2626;font-weight:600;text-transform:uppercase;">Needs Improvement</div>
    <div style="font-size:20px;font-weight:bold;color:#b91c1c;"><%= comparison.worstPerformer %></div>
    <% const worst = rankings[rankings.length - 1]; %>
    <div style="font-size:13px;color:#f87171;">Composite: <%= worst.compositeScore %></div>
  </div>
  <% } %>
</div>
<% } %>

<h2>Skill Comparison</h2>
<div class="composite-formula">Composite Score = 35% Static + 35% Dynamic + 15% Efficiency + 15% Security</div>
<table id="comparison-table">
<tr>
<th onclick="sortTable(0)" style="width:60px;">Rank</th>
<th onclick="sortTable(1)">Skill</th>
<th onclick="sortTable(2)" style="text-align:center;width:100px;">Static</th>
<th onclick="sortTable(3)" style="text-align:center;width:110px;">Dynamic</th>
<th onclick="sortTable(4)" style="text-align:center;width:100px;">Efficiency</th>
<th onclick="sortTable(5)" style="text-align:center;width:90px;">Tokens</th>
<th onclick="sortTable(6)" style="text-align:center;width:90px;">Thrashing</th>
<th onclick="sortTable(7)" style="text-align:center;width:90px;">Security</th>
<th onclick="sortTable(8)" style="text-align:center;width:100px;">Composite</th>
</tr>
<% for (const r of rankings) {
  const sColor = scoreColor(r.staticScore ?? 0);
  const dColor = scoreColor(r.dynamicPassRate);
  const eColor = scoreColor(r.efficiencyAvg ?? 0);
  const cColor = scoreColor(r.compositeScore);
  const secColor = scoreColor(r.securityAvg ?? 100);
%>
<tr>
  <td style="text-align:center;font-weight:bold;font-size:18px;color:#6b7280;">#<%= r.rank %></td>
  <td><strong><%= r.skillName %></strong></td>
  <td style="text-align:center;color:<%= sColor %>;font-weight:bold;"><%= r.staticScore != null ? r.staticScore + '%' : 'N/A' %></td>
  <td style="text-align:center;color:<%= dColor %>;font-weight:bold;"><%= r.dynamicPassRate %>%<br><span style="font-size:11px;color:#6b7280;"><%= r.passedCount %>/<%= r.testCount %></span></td>
  <td style="text-align:center;color:<%= eColor %>;font-weight:bold;"><%= r.efficiencyAvg != null ? r.efficiencyAvg + '%' : 'N/A' %></td>
  <td style="text-align:center;"><%= r.totalTokens ? r.totalTokens.toLocaleString() : 'N/A' %></td>
  <td style="text-align:center;">
    <% if (r.thrashingCount > 0) { %>
    <span style="background:#fef2f2;color:#ef4444;padding:2px 8px;border-radius:10px;font-size:11px;">Yes (<%= r.thrashingCount %>)</span>
    <% } else { %>
    <span style="background:#f0fdf4;color:#22c55e;padding:2px 8px;border-radius:10px;font-size:11px;">No</span>
    <% } %>
  </td>
  <td style="text-align:center;color:<%= secColor %>;font-weight:bold;"><%= r.securityAvg != null ? r.securityAvg + '%' : 'N/A' %></td>
  <td style="text-align:center;"><strong style="font-size:20px;color:<%= cColor %>;"><%= r.compositeScore %></strong></td>
</tr>
<% } %>
</table>

<h2>Rankings</h2>
<div class="ranking-section">
<% const maxComposite = rankings.length > 0 ? Math.max(...rankings.map(r => r.compositeScore), 1) : 1; %>
<% for (const r of rankings) {
  const pct = Math.round((r.compositeScore / maxComposite) * 100);
  const barColor = scoreColor(r.compositeScore);
%>
<div style="display:flex;align-items:center;margin-bottom:8px;">
  <div style="width:180px;font-weight:500;font-size:13px;color:#374151;">#<%= r.rank %> <%= r.skillName %></div>
  <div style="flex:1;background:#f3f4f6;border-radius:6px;height:24px;overflow:hidden;">
    <div style="width:<%= pct %>%;background:<%= barColor %>;height:100%;border-radius:6px;transition:width .3s;"></div>
  </div>
  <div style="width:60px;text-align:right;font-weight:bold;font-size:14px;color:<%= barColor %>;"><%= r.compositeScore %></div>
</div>
<% } %>
</div>

<h2>Per-Skill Details</h2>
<p style="font-size:13px;color:#6b7280;">Click on a skill to expand its detailed evaluation.</p>

<% for (const skill of (dynamicEval.skills || [])) {
  const rankInfo = rankings.find(r => r.skillName === skill.skillName);
  const passRate = skill.summary && skill.summary.total
    ? Math.round((skill.summary.passed / skill.summary.total) * 100) : 0;
  const prColor = scoreColor(passRate);
%>
<div class="detail-panel">
  <div class="detail-header" onclick="this.parentElement.classList.toggle('open')">
    <span style="font-size:18px;font-weight:bold;"><%= skill.skillName %></span>
    <span style="margin-left:auto;display:flex;gap:16px;align-items:center;">
      <% if (rankInfo) { %>
      <span style="font-size:13px;color:#6b7280;">Rank #<%= rankInfo.rank %></span>
      <span style="font-size:13px;color:#6b7280;">Composite: <strong style="color:<%= prColor %>;"><%= rankInfo.compositeScore %></strong></span>
      <% } %>
      <span style="color:<%= prColor %>;font-weight:bold;"><%= passRate %>% pass</span>
      <span class="chevron">&#9660;</span>
    </span>
  </div>
  <div class="detail-body">

    <%/* Static eval for this skill */ %>
    <% if (staticEval.data) {
      const matchedKey = Object.keys(staticEval.data).find(k =>
        k.toLowerCase().includes(skill.skillName.toLowerCase()) ||
        skill.skillName.toLowerCase().includes(k.toLowerCase())
      );
      if (matchedKey) {
        const sd = staticEval.data[matchedKey];
        const staticScore = (staticEval.summary && staticEval.summary.scores && staticEval.summary.scores[matchedKey])
          ? staticEval.summary.scores[matchedKey].mean_score : '?';
    %>
    <h4>Static Evaluation (<%= staticScore %>%)</h4>
    <% for (const evalId in sd.scores) {
      const er = sd.scores[evalId];
      const eColor = scoreColor(er.percentage);
    %>
    <div class="eval-block">
      <strong style="color:<%= eColor %>;"><%= er.eval_name %>: <%= er.percentage %>%</strong>
      <ul style="margin:4px 0 0;padding-left:18px;font-size:12px;">
      <% for (const c of (er.criteria_results || [])) { %>
        <li><span style="color:<%= c.passed ? '#22c55e' : '#ef4444' %>;"><%= c.passed ? '✓' : '✗' %></span> <%= c.name %> (<%= c.score %>/<%= c.weight %>)</li>
      <% } %>
      </ul>
    </div>
    <% } /* end eval loop */ %>
    <% } /* end matchedKey */ %>
    <% } /* end staticEval.data */ %>

    <%/* Dynamic test cases */ %>
    <h4>Dynamic Test Cases</h4>
    <p style="font-size:12px;color:#9ca3af;margin:4px 0 12px;">Click a test case to see prompt, agent response, and tool calls.</p>

    <% for (const tm of (skill.traceMetrics || [])) {
      const tmPassed = tm.passed;
      const statusIcon = tmPassed ? '<span style="color:#22c55e;">✓ Pass</span>' : '<span style="color:#ef4444;">✗ Fail</span>';
      const thrashTag = (tm.thrashing && tm.thrashing.isThrashing)
        ? '<span class="badge badge-thrash">THRASHING</span>' : '';
      const shouldTrig = tm.shouldTrigger != null ? tm.shouldTrigger : true;
      const trigCorrect = tm.triggerResult
        ? (shouldTrig ? tm.triggerResult.triggered : !tm.triggerResult.triggered)
        : true;
      let triggerBadge = '';
      if (!trigCorrect) {
        triggerBadge = shouldTrig
          ? '<span class="badge badge-not-triggered">NOT TRIGGERED</span>'
          : '<span class="badge badge-false-trigger">FALSE TRIGGER</span>';
      }
      const tokenDisplay = (tm.tokenUsage && tm.tokenUsage.total != null) ? tm.tokenUsage.total.toLocaleString() : 'N/A';
      const catBadge = tm.category
        ? '<span class="badge badge-category">' + esc(tm.category) + '</span>' : '';
      const secResult = tm.securityResult;
      let secBadge = '';
      if (secResult) {
        secBadge = secResult.percentage >= 70
          ? '<span class="badge badge-sec-pass">SEC ' + secResult.percentage + '%</span>'
          : '<span class="badge badge-sec-fail">SEC ' + secResult.percentage + '%</span>';
      }
    %>
    <div class="test-case-panel">
      <div class="test-case-header" onclick="this.parentElement.classList.toggle('open')">
        <span style="display:flex;align-items:center;gap:8px;"><%- statusIcon %> <strong><%= tm.testId %></strong><%- catBadge %> <%- thrashTag %> <%- triggerBadge %> <%- secBadge %></span>
        <span style="display:flex;gap:16px;align-items:center;font-size:12px;color:#6b7280;">
          <span>Cmds: <%= tm.commandCount %></span>
          <span>Errors: <%= tm.errorCount %></span>
          <span>Eff: <%= tm.efficiencyScore != null ? tm.efficiencyScore + '%' : 'N/A' %></span>
          <span>Tokens: <%= tokenDisplay %></span>
          <span class="chevron" style="font-size:10px;">&#9660;</span>
        </span>
      </div>
      <div class="test-case-body">

        <% if (tm.prompt) { %>
        <div class="trace-section">
          <div class="trace-section-title">Prompt</div>
          <div class="trace-prompt"><%= esc(tm.prompt) %></div>
        </div>
        <% } %>

        <% if (tm.triggerResult) {
          const tr = tm.triggerResult;
          const shouldTrigger = tm.shouldTrigger != null ? tm.shouldTrigger : true;
          const triggerCorrect = shouldTrigger ? tr.triggered : !tr.triggered;
          const triggerColor = triggerCorrect ? '#22c55e' : '#ef4444';
          const triggerIcon = triggerCorrect ? '✓' : '✗';
          let triggerLabel;
          if (shouldTrigger) {
            triggerLabel = tr.triggered ? 'Skill triggered (expected)' : 'Skill NOT triggered (expected to trigger)';
          } else {
            triggerLabel = tr.triggered ? 'Skill triggered (should NOT have)' : 'Skill correctly not triggered';
          }
        %>
        <div class="trace-section" style="border-left-color:<%= triggerColor %>;">
          <div class="trace-section-title" style="color:<%= triggerColor %>;"><%= triggerIcon %> Trigger Validation: <%= triggerLabel %></div>
          <div style="font-size:12px;color:#6b7280;"><%= esc(tr.reason || '') %></div>
        </div>
        <% } %>

        <% if (tm.securityResult) {
          const sr = tm.securityResult;
          const secColor = scoreColor(sr.percentage);
          const secIcon = sr.percentage >= 70 ? '&#128274;' : '&#9888;';
        %>
        <div class="trace-section" style="border-left-color:<%= secColor %>;">
          <div class="trace-section-title" style="color:<%= secColor %>;"><%- secIcon %> Security Analysis: <%= sr.percentage %>% (<%= sr.score %>/<%= sr.maxScore %>)</div>
          <% if (sr.vulnerabilities && sr.vulnerabilities.length > 0) { %>
          <div style="font-size:12px;color:#b91c1c;margin-bottom:6px;">Vulnerabilities: <%= sr.vulnerabilities.join(', ') %></div>
          <% } %>
          <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
          <% for (const chk of (sr.checks || [])) {
            const chkColor = chk.pass ? '#22c55e' : '#ef4444';
            const chkBg = chk.pass ? '#f0fdf4' : '#fef2f2';
            const chkIcon = chk.pass ? '✓' : '✗';
            let sevBadge = '';
            if (!chk.pass) {
              const sevColor = chk.severity === 'critical' ? '#b91c1c' : chk.severity === 'high' ? '#ef4444' : '#eab308';
              sevBadge = '<span style="font-size:9px;color:white;background:' + sevColor + ';padding:0 4px;border-radius:3px;margin-left:4px;">' + esc(chk.severity) + '</span>';
            }
          %>
          <div style="background:<%= chkBg %>;border:1px solid <%= chkColor %>33;border-radius:6px;padding:4px 8px;font-size:11px;color:<%= chkColor %>;">
            <%- chkIcon %> <%= chk.name %><%- sevBadge %>
          </div>
          <% } %>
          </div>
        </div>
        <% } %>

        <% if (tm.thrashing && tm.thrashing.isThrashing) { %>
        <div class="trace-section" style="border-left-color:#ef4444;">
          <div class="trace-section-title" style="color:#ef4444;">Thrashing Detected</div>
          <div style="font-size:12px;color:#6b7280;"><%= tm.thrashing.reason || 'Same command repeated excessively' %></div>
          <% if (tm.thrashing.command) { %>
          <code style="display:block;margin-top:4px;padding:6px;background:#fef2f2;border-radius:4px;font-size:11px;color:#b91c1c;word-break:break-all;"><%= esc(String(tm.thrashing.command).substring(0, 200)) %></code>
          <% } %>
        </div>
        <% } %>

        <% const td = tm.traceDetails; %>
        <% if (td) { %>
          <% if (td.messages && td.messages.length > 0) { %>
          <div class="trace-section">
            <div class="trace-section-title">Agent Messages (<%= td.messages.length %>)</div>
            <% for (const msg of td.messages) {
              const escapedContent = esc(msg.content || '');
              const truncated = escapedContent.length > 500 ? escapedContent.substring(0, 500) + '...' : escapedContent;
            %>
            <div class="trace-message"><%= truncated %></div>
            <% } %>
          </div>
          <% } %>

          <% if (td.toolCalls && td.toolCalls.length > 0) { %>
          <div class="trace-section">
            <div class="trace-section-title">Tool Calls (<%= td.toolCalls.length %>)</div>
            <div class="tool-timeline">
            <% for (const tc of td.toolCalls) {
              const inputStr = tc.input ? JSON.stringify(tc.input) : '';
              const truncInput = inputStr.length > 200 ? inputStr.substring(0, 200) + '...' : inputStr;
              const escapedInput = esc(truncInput);
            %>
            <div class="tool-call-item">
              <span class="tool-name"><%= tc.tool || 'unknown' %></span>
              <% if (escapedInput) { %><code class="tool-input"><%= escapedInput %></code><% } %>
            </div>
            <% } %>
            </div>
          </div>
          <% } %>

          <% if (td.errors && td.errors.length > 0) { %>
          <div class="trace-section" style="border-left-color:#ef4444;">
            <div class="trace-section-title" style="color:#ef4444;">Errors (<%= td.errors.length %>)</div>
            <% for (const err of td.errors) { %>
            <div class="trace-error"><%= err.type %>: <%= esc(err.message || '') %></div>
            <% } %>
          </div>
          <% } %>

          <div style="font-size:11px;color:#9ca3af;margin-top:8px;">Total trace events: <%= td.eventCount || 0 %></div>
        <% } /* end td */ %>

        <% if (tm.tracePath) { %>
        <div style="font-size:11px;color:#9ca3af;margin-top:4px;">Trace: <code style="font-size:10px;"><%= tm.tracePath %></code></div>
        <% } %>

      </div>
    </div>
    <% } /* end traceMetrics loop */ %>

  </div>
</div>
<% } /* end skills loop */ %>

<script>
let sortDir = {};
function sortTable(col) {
  const table = document.getElementById('comparison-table');
  const rows = Array.from(table.rows).slice(1);
  const dir = sortDir[col] = !(sortDir[col] || false);
  rows.sort((a, b) => {
    let av = a.cells[col].textContent.replace(/[^0-9.-]/g, '');
    let bv = b.cells[col].textContent.replace(/[^0-9.-]/g, '');
    av = parseFloat(av) || 0;
    bv = parseFloat(bv) || 0;
    return dir ? av - bv : bv - av;
  });
  rows.forEach(r => table.appendChild(r));
}
const firstPanel = document.querySelector('.detail-panel');
if (firstPanel) firstPanel.classList.add('open');
</script>

<% } else if (isPipeline) { %>
<%/* ===== PIPELINE REPORT ===== */ %>

<h1>Pipeline Evaluation Report</h1>
<p style="color:#6b7280;">Run: <%= data.run_id %> | <%= data.created_at %></p>

<%
  const pipelineSummary = data.summary || {};
  const pCards = [
    { label: 'Skills Evaluated', value: pipelineSummary.total_skills_evaluated || 0, cls: 'blue' },
    { label: 'Static Score', value: (pipelineSummary.static_score != null ? pipelineSummary.static_score + '%' : 'N/A'), cls: 'purple' },
    { label: 'Dynamic Pass Rate', value: (pipelineSummary.dynamic_pass_rate != null ? pipelineSummary.dynamic_pass_rate + '%' : 'N/A'), cls: 'green' },
    { label: 'Dynamic Tests', value: pipelineSummary.total_dynamic_tests || 0, cls: 'blue' },
    { label: 'Thrashing', value: dynamicEval.thrashing_count || 0, cls: (dynamicEval.thrashing_count || 0) > 0 ? 'red' : 'green' },
    { label: 'Total Tokens', value: (dynamicEval.total_tokens || 0).toLocaleString(), cls: 'blue' }
  ];
%>
<div class="summary">
<% for (const c of pCards) { %>
  <div class="card <%= c.cls %>"><h3><%= c.label %></h3><p><%= c.value %></p></div>
<% } %>
</div>

<h2>Static Evaluation</h2>
<% if (staticEval.data) { %>
<table>
<tr><th style="width:20%;">Skill</th><th style="width:10%;text-align:center;">Score</th><th>Evaluation Details</th></tr>
<% for (const skillId in staticEval.data) {
  const skillData = staticEval.data[skillId];
  const score = (staticEval.summary && staticEval.summary.scores && staticEval.summary.scores[skillId])
    ? staticEval.summary.scores[skillId].mean_score : '?';
  const color = scoreColor(typeof score === 'number' ? score : 0);
%>
<tr style="background:<%= color %>10%">
  <td><strong><%= skillData.skill_name %></strong><br><span style="font-size:12px;color:#6b7280;"><%= skillData.platform %></span></td>
  <td style="text-align:center;"><strong style="font-size:24px;color:<%= color %>;"><%= score %>%</strong></td>
  <td>
  <% for (const evalId in skillData.scores) {
    const evalResult = skillData.scores[evalId];
    const eColor = scoreColor(evalResult.percentage);
  %>
  <div class="eval-block">
    <strong style="color:<%= eColor %>;"><%= evalResult.eval_name %>: <%= evalResult.percentage %>%</strong>
    <ul style="margin:6px 0 0;padding-left:18px;font-size:12px;">
    <% for (const c of (evalResult.criteria_results || [])) { %>
      <li><span style="color:<%= c.passed ? '#22c55e' : '#ef4444' %>;"><%= c.passed ? '✓' : '✗' %></span> <%= c.name %> (<%= c.score %>/<%= c.weight %>)</li>
    <% } %>
    </ul>
  </div>
  <% } %>
  </td>
</tr>
<% } %>
</table>
<% } %>

<h2>Dynamic Execution Results</h2>
<table>
<tr><th style="width:20%;">Skill</th><th style="width:15%;text-align:center;">Pass Rate</th><th>Trace Metrics</th></tr>
<% for (const skill of (dynamicEval.skills || [])) {
  const passRate = skill.summary && skill.summary.total
    ? Math.round((skill.summary.passed / skill.summary.total) * 100) : 0;
  const prColor = scoreColor(passRate);
%>
<tr>
  <td><strong><%= skill.skillName %></strong><br><span style="font-size:12px;color:#6b7280;"><%= skill.backend || '' %></span></td>
  <td style="text-align:center;"><strong style="font-size:24px;color:<%= prColor %>;"><%= passRate %>%</strong><br><span style="font-size:12px;"><%= skill.summary.passed || 0 %>/<%= skill.summary.total || 0 %></span></td>
  <td>
    <ul style="margin:0;padding-left:18px;font-size:13px;">
    <% for (const tm of (skill.traceMetrics || [])) {
      const icon = tm.passed ? '✓' : '✗';
      const iconColor = tm.passed ? '#22c55e' : '#ef4444';
      const thrashTag = (tm.thrashing && tm.thrashing.isThrashing)
        ? '<span style="color:#ef4444;font-weight:bold;"> [THRASHING]</span>' : '';
    %>
      <li style="margin-bottom:4px;"><span style="color:<%= iconColor %>;"><%= icon %></span> <%= tm.testId %> — cmds: <%= tm.commandCount %>, errors: <%= tm.errorCount %>, efficiency: <%= tm.efficiencyScore != null ? tm.efficiencyScore + '%' : 'N/A' %><%- thrashTag %></li>
    <% } %>
    </ul>
  </td>
</tr>
<% } %>
</table>

<% } else { %>
<%/* ===== SIMPLE HTML REPORT ===== */ %>

<h1>Agent Skills Evaluation Report</h1>
<p style="color: #6b7280;">Run ID: <%= data.run_id %> | Created: <%= data.created_at %></p>

<div class="dimensions">
<h3>Evaluation Dimensions (OpenAI eval-skills)</h3>
<ul>
<li><strong>1. Outcome Goals:</strong> Did the task complete? Does the application run?</li>
<li><strong>2. Process Goals:</strong> Did the Agent invoke the skill and follow expected steps?</li>
<li><strong>3. Style Goals:</strong> Does output follow agreed conventions?</li>
<li><strong>4. Efficiency Goals:</strong> Completed efficiently? Any unnecessary waste?</li>
<li><strong>5. Security Assessment:</strong> No hardcoded secrets, safe execution patterns</li>
</ul>
</div>

<div class="summary">
  <div class="card default"><h3>Total Skills</h3><p><%= data.summary.stats.total_skills %></p></div>
  <div class="card default"><h3>Dimensions</h3><p><%= data.summary.stats.total_evals %></p></div>
  <div class="card passed"><h3>Secure (>=70%)</h3><p><%= data.summary.stats.passed %></p></div>
  <div class="card failed"><h3>Needs Work (<70%)</h3><p><%= data.summary.stats.failed %></p></div>
  <div class="card default"><h3>Average Score</h3><p><%= data.summary.aggregate_scores.mean %>%</p></div>
  <div class="card default"><h3>Median Score</h3><p><%= data.summary.aggregate_scores.median %>%</p></div>
</div>

<h2>Detailed Results</h2>
<table class="simple-table">
<tr><th style="width: 20%;">Skill</th><th style="width: 10%; text-align: center;">Score</th><th style="width: 70%;">Evaluation Details & Reasoning</th></tr>
<% for (const skillId in data.data) {
  const skillData = data.data[skillId];
  const score = data.summary.scores[skillId].mean_score;
  const color = scoreColor(score);
%>
<tr style="background: <%= color %>10%">
  <td><strong><%= skillData.skill_name %></strong><br><span style="font-size: 12px; color: #6b7280;"><%= skillData.platform %></span></td>
  <td style="text-align: center;"><strong style="font-size: 24px; color: <%= color %>;"><%= score %>%</strong></td>
  <td>
  <% for (const evalId in skillData.scores) {
    const evalResult = skillData.scores[evalId];
    const evalColor = scoreColor(evalResult.percentage);
  %>
  <div class="eval-block-full">
    <strong style="color: <%= evalColor %>;"><%= evalResult.eval_name %>: <%= evalResult.percentage %>%</strong>
    <p style="font-size: 12px; color: #6b7280; margin: 5px 0;"><%= evalResult.description %></p>
    <ul style="margin: 8px 0 0 0; padding-left: 20px; font-size: 12px; color: #4b5563;">
    <% for (const criterion of evalResult.criteria_results) {
      const statusIcon = criterion.passed ? '✓' : '✗';
      const statusColor = criterion.passed ? '#22c55e' : '#ef4444';
    %>
      <li style="margin-bottom: 4px;"><span style="color: <%= statusColor %>;"><%= statusIcon %></span> <strong><%= criterion.name %></strong> (<%= criterion.score %>/<%= criterion.weight %>)<br>
      <span style="color: #6b7280; font-style: italic;"><%= criterion.reasoning %></span></li>
    <% } %>
    </ul>
  </div>
  <% } %>
  </td>
</tr>
<% } %>
</table>

<%
  // Build benchmark stats
  const benchmarkStats = {};
  for (const skillId in data.data) {
    const skillData = data.data[skillId];
    for (const evalId in skillData.scores) {
      const evalResult = skillData.scores[evalId];
      if (!benchmarkStats[evalId]) {
        benchmarkStats[evalId] = { count: 0, total: 0, name: evalResult.eval_name };
      }
      benchmarkStats[evalId].count++;
      benchmarkStats[evalId].total += evalResult.percentage;
    }
  }
%>
<h2>Dimension Breakdown</h2>
<table class="simple-table">
<tr><th>Dimension</th><th>Skills Tested</th><th>Average Score</th></tr>
<% for (const benchmarkId in benchmarkStats) {
  const stats = benchmarkStats[benchmarkId];
  const avg = Math.round(stats.total / stats.count);
  const color = scoreColor(avg);
%>
<tr><td><%= stats.name %></td><td><%= stats.count %></td><td style="color: <%= color %>; font-weight: bold;"><%= avg %>%</td></tr>
<% } %>
</table>

<% } %>

</div>
</body>
</html>