  "injectionVulnerabilities": [
    { "pattern": "\\beval\\s*\\(", "flags": "gi", "severity": "high", "name": "eval() usage", "fix": "Use JSON.parse() or safer alternatives" },
    { "pattern": "new\\s+Function\\s*\\(", "flags": "gi", "severity": "high", "name": "Function constructor", "fix": "Avoid dynamic code execution" },
    { "pattern": "\\bexec\\s*\\(", "flags": "gi", "severity": "high", "name": "exec() usage", "fix": "Use execFile() with array arguments" },
