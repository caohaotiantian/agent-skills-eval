    { "pattern": "apikey\\s*[:=]\\s*['\"][a-zA-Z0-9_-]{20,}['\"]", "flags": "gi", "severity": "critical", "name": "API Key" },
    { "pattern": "secret\\s*[:=]\\s*['\"][a-zA-Z0-9_-]{20,}['\"]", "flags": "gi", "severity": "critical", "name": "Secret" },
    { "pattern": "token\\s*[:=]\\s*['\"][a-zA-Z0-9_-]{20,}['\"]", "flags": "gi", "severity": "critical", "name": "Token" },
    { "pattern": "password\\s*[:=]\\s*['\"][^'\"]+['\"]", "flags": "gi", "severity": "critical", "name": "Password" },
    { "pattern": "private[_-]?key\\s*[:=]\\s*['\"][^-\"']+['\"]", "flags": "gi", "severity": "critical", "name": "Private Key" },
    { "pattern": "aws[_-]?secret[_-]?(?:access[_-]?key)?\\s*[:=]\\s*['\"][a-zA-Z0-9/+=]{20,}['\"]", "flags": "gi", "severity": "critical", "name": "AWS Secret" },
    { "pattern": "openai[_-]?api[_-]?key\\s*[:=]\\s*['\"][a-zA-Z0-9_-]{20,}['\"]", "flags": "gi", "severity": "critical", "name": "OpenAI API Key" }
  ],
  "injectionVulnerabilities": [
    { "pattern": "\\beval\\s*\\(", "flags": "gi", "severity": "high", "name": "eval() usage", "fix": "Use JSON.parse() or safer alternatives" },
    { "pattern": "new\\s+Function\\s*\\(", "flags": "gi", "severity": "high", "name": "Function constructor", "fix": "Avoid dynamic code execution" },
    { "pattern": "\\bexecSync\\s*\\(|\\bexecFile\\s*\\(|child_process[\\s\\S]{0,200}\\bexec\\s*\\(", "flags": "gi", "severity": "high", "name": "exec() usage", "fix": "Use execFile() with array arguments" },
    { "pattern": "\\.innerHTML\\s*=", "flags": "gi", "severity": "high", "name": "innerHTML assignment", "fix": "Use textContent or DOMPurify" },
    { "pattern": "dangerouslySetInnerHTML", "flags": "gi", "severity": "medium", "name": "React dangerouslySetInnerHTML", "fix": "Sanitize content first" },
    { "pattern": "document\\.write\\s*\\(", "flags": "gi", "severity": "high", "name": "document.write", "fix": "Use DOM manipulation methods" },
    { "pattern": "\\bsql\\s*Interpolat|interpolate.*sql", "flags": "i", "severity": "high", "name": "SQL interpolation", "fix": "Use parameterized queries" },
    { "pattern": "format\\s*\\(.*%[sb]", "flags": "gi", "severity": "medium", "name": "String format injection", "fix": "Use template literals or safe formatting" },
    { "pattern": "\\.__proto__\\s*[.\\[=]", "flags": "gi", "severity": "high", "name": "Prototype pollution (__proto__)", "fix": "Use Object.create(null) or Map instead" },
    { "pattern": "\\.constructor\\.prototype\\s*[.\\[=]", "flags": "gi", "severity": "high", "name": "Prototype pollution (constructor.prototype)", "fix": "Use Object.create(null) or Map instead" }
  ],
  "pathTraversal": [
    { "pattern": "readFile\\s*\\([^)]*\\.\\.[^)]*\\)", "flags": "gi", "severity": "high", "name": "readFile with path traversal" },
    { "pattern": "writeFile\\s*\\([^)]*\\.\\.[^)]*\\)", "flags": "gi", "severity": "high", "name": "writeFile with path traversal" },
    { "pattern": "(?:readFile|writeFile|createReadStream|createWriteStream|open)\\s*\\([^)]*(?:req\\.|params\\.|query\\.|body\\.)", "flags": "gi", "severity": "high", "name": "File I/O with user-controlled path" },
    { "pattern": "import\\s*\\(\\s*(?:req\\.|params\\.|query\\.|body\\.)", "flags": "gi", "severity": "high", "name": "Dynamic import with user input" }
  ],
  "insecureOperations": [
    { "pattern": "http:\\/\\/(?!localhost|127\\.0\\.0\\.1)", "flags": "gi", "severity": "medium", "name": "HTTP (non-TLS)", "fix": "Use HTTPS instead" },
    { "pattern": "Math\\.random\\s*\\(", "flags": "gi", "severity": "medium", "name": "Math.random for crypto", "fix": "Use crypto.getRandomValues()" },
    { "pattern": "crypto\\.random\\s*\\(", "flags": "gi", "severity": "medium", "name": "Insecure random", "fix": "Use crypto.getRandomValues()" },
    { "pattern": "DES\\.|3DES\\.|RC4\\b", "flags": "gi", "severity": "high", "name": "Weak encryption algorithm", "fix": "Use AES-256 or ChaCha20" },
    { "pattern": "MD5\\b|SHA1\\b", "flags": "gi", "severity": "medium", "name": "Weak hash algorithm", "fix": "Use SHA-256 or stronger" },
    { "pattern": "ECB\\b", "flags": "gi", "severity": "medium", "name": "ECB mode encryption", "fix": "Use CBC or GCM mode" },
    { "pattern": "PKCS1v1_5\\b|PKCS#1\\s*v1\\.5", "flags": "gi", "severity": "medium", "name": "Insecure padding", "fix": "Use OAEP padding" }
  ],
  "sensitiveData": [
    { "pattern": "console\\.(log|info)\\s*\\([^)]*(password|secret|token|key|credential)", "flags": "gi", "severity": "medium", "name": "Sensitive data in logs" },
    { "pattern": "error\\s*\\(.*password", "flags": "i", "severity": "high", "name": "Password in error messages" },
    { "pattern": "JSON\\.stringify\\s*\\([^)]*(password|secret|token|key)", "flags": "gi", "severity": "high", "name": "Sensitive data serialization" },
    { "pattern": "process\\.env\\[.*(PASSWORD|SECRET|KEY|TOKEN)", "flags": "gi", "severity": "low", "name": "Sensitive env var access" }
  ]
}
