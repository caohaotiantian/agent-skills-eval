    { "pattern": "writeFile\\s*\\([^)]*\\.\\.[^)]*\\)", "flags": "gi", "severity": "high", "name": "writeFile with path traversal" },
    { "pattern": "import\\s*\\(.*\\.\\.\\/", "flags": "gi", "severity": "medium", "name": "Dynamic import with traversal" },
    { "pattern": "require\\s*\\([^)]*\\.\\.\\/", "flags": "gi", "severity": "medium", "name": "require with path traversal" }
  ],
  "insecureOperations": [
    { "pattern": "http:\\/\\/", "flags": "gi", "severity": "medium", "name": "HTTP (non-TLS)", "fix": "Use HTTPS instead" },
    { "pattern": "Math\\.random\\s*\\(", "flags": "gi", "severity": "medium", "name": "Math.random for crypto", "fix": "Use crypto.getRandomValues()" },
    { "pattern": "crypto\\.random\\s*\\(", "flags": "gi", "severity": "medium", "name": "Insecure random", "fix": "Use crypto.getRandomValues()" },
